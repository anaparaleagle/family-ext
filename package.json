{
  "name": "paraleagle-family-ext",
  "version": "0.10.6",
  "private": true,
  "description": "Fill a ParaLeagle case into the guided I-130, N-400 and ETA-9141 forms, and more, on my.uscis.gov and flag.dol.gov",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "check:listing": "node tools/check-live-listing.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.21.0",
    "happy-dom": "^14.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "firebase": "^12.11.0"
  }
}
